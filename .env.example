# Copy to .env and fill in values from your Supabase project (Settings → API).
# Only the publishable key belongs here: it is public by design and safe in the browser.
# Never put a service-role / secret key in this file or in any VITE_* variable.

# Used by server functions (src/data/portfolio.functions.ts)
SUPABASE_PROJECT_ID=
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Site assistant (server only). Set it in the hosting provider's secrets
# (Lovable Cloud), or in .env.local for local runs. .env.local is git-ignored;
# never put this key in .env, which is committed, or in a VITE_* variable.
# ANTHROPIC_API_KEY=sk-ant-...

# Exposed to the browser (admin panel, auth)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
