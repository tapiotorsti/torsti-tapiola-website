# Copy to .env and fill in values from your Supabase project (Settings → API).
# Only the publishable key belongs here: it is public by design and safe in the browser.
# Never put a service-role / secret key in this file or in any VITE_* variable.

# Used by server functions (src/data/portfolio.functions.ts)
SUPABASE_PROJECT_ID=
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Exposed to the browser (admin panel, auth)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
